{
  "name": "dokustick-tests",
  "private": true,
  "type": "module",
  "description": "Automatische Tests für die ProtoPilot-Web-App und die Supabase-Datenbank",
  "scripts": {
    "test": "node run.mjs",
    "test:offline": "node run.mjs --ohne-cloud",
    "db:start": "supabase start --workdir ..",
    "db:stop": "supabase stop --workdir ..",
    "db:reset": "supabase db reset --workdir ..",
    "db:status": "supabase status --workdir .."
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.117.2",
    "playwright": "1.56.1",
    "supabase": "2.119.0"
  }
}
